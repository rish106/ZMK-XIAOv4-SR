//#include <behaviors/mouse_keys.dtsi>

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE       &kp N1     &kp N2    &kp N3        &kp N4         &kp N5          &kp N6             &kp N7         &kp N8      &kp N9    &kp N0    &kp MINUS
&kp TAB         &kp Q      &kp W     &kp E         &kp R          &kp T           &kp Y              &kp U          &kp I       &kp O     &kp P     &kp EQUAL
&kp LEFT_SHIFT  &kp A      &kp S     &kp D         &kp F          &kp G           &kp H              &kp J          &kp K       &kp L     &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z      &kp X     &kp C         &kp V          &kp B           &kp N              &kp M          &kp COMMA   &kp DOT   &kp FSLH  &mo 3
                &kp GRAVE  &kp BSLH  &kp LEFT      &kp RIGHT                                         &kp UP         &kp DOWN    &kp LBKT  &kp RBKT
                                                   &kp LCTRL      &mo 2           &mo 1              &kp RIGHT_ALT
                                     &lt 1 ESCAPE  &kp BACKSPACE  &kp LEFT_GUI    &kp RIGHT_SHIFT    &kp SPACE      &kp RETURN
                                                                  &kp LEFT_ALT    &kp RIGHT_COMMAND
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC   &kp LG(LC(LA(LS(N3))))  &kp LS(LA(LC(LG(N4))))  &kp LS(LA(LC(LG(N5))))    &kp LS(LA(LC(LG(N6))))  &kp C_REWIND           &kp C_PAUSE            &kp C_AC_FORWARD       &kp C_MUTE                &kp C_VOLUME_DOWN
&trans  &trans                 &kp LS(LG(LC(LA(W))))  &trans                  &trans                  &trans                    &kp LS(LG(LC(LA(Y))))   &kp LS(LG(LC(LA(U))))  &kp LS(LG(LC(LA(I))))  &kp LS(LG(LC(LA(O))))  &kp LS(LG(LC(LA(P))))     &kp C_VOLUME_UP
&trans  &kp LS(LG(LC(LA(A))))  &kp LS(LG(LC(LA(S))))  &kp LS(LG(LC(LA(D))))   &kp LS(LG(LC(LA(F))))   &kp LS(LA(LC(LG(G))))     &kp LEFT                &kp DOWN               &kp UP                 &kp RIGHT              &kp LS(LG(LC(LA(SEMI))))  &trans
&trans  &kp LS(LG(LC(LA(Z))))  &kp LS(LG(LC(LA(X))))  &kp LS(LG(LC(LA(C))))   &kp LS(LA(LC(LG(V))))   &kp LS(LG(LC(LA(B))))     &kp LS(LG(LC(LA(N))))   &kp LS(LG(LC(LA(M))))  &trans                 &trans                 &trans                    &trans
        &trans                 &trans                 &trans                  &trans                                                                    &trans                 &trans                 &trans                 &trans
                                                                              &trans                  &trans                    &trans                  &trans
                                                      &trans                  &trans                  &trans                    &trans                  &trans                 &trans
                                                                                                      &trans                    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans   &trans
        &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans
                                &trans  &trans    &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                                        &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans    &trans  &trans  &trans  &trans  &trans  &out OUT_TOG
&trans      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
            &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans
                                                      &trans        &trans    &trans  &trans
                                        &trans        &trans        &trans    &trans  &trans  &trans
                                                                    &trans    &trans
            >;
        };
    };
};

// //right hand trackball overrides
